# Copie para .env e preencha. Nunca suba o .env para o GitHub.

# Domínio que aponta para o servidor (para o HTTPS do Caddy)
DOMINIO=bots.seudominio.com.br
POSTGRES_PASSWORD=troque-esta-senha

# Vai no endereço do webhook: /webhook/avisa/<id da conexão>?key=<este valor>. Mínimo 16 caracteres.
# Gere com: openssl rand -hex 24
WEBHOOK_SECRET=

# Um token por número de WhatsApp. O nome da variável é o "variavel_do_token" do arquivo de cadastro.
AVISA_TOKEN_FELIPE=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GOOGLE_MAPS_API_KEY=

# Bot de dúvidas técnicas (módulo tecnico): Claude + fichas no Qdrant
ANTHROPIC_API_KEY=
TECNICO_MODEL=claude-sonnet-5-5
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=gss_base_tecnica
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

LOG_LEVEL=info
SCHEDULER=on
