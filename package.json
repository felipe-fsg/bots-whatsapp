{
  "name": "bots-whatsapp",
  "version": "0.1.0",
  "description": "Núcleo multi-cliente de bots para grupos de WhatsApp (primeiro módulo: Mestre Splinter)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "seed": "tsx scripts/cadastrar.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^9.4.0",
    "croner": "^9.1.0",
    "fastify": "^5.12.8",
    "luxon": "^3.7.2",
    "pino": "^9.14.0",
    "postgres": "^3.4.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
